{
    "name": "planificador/visitas",
    "description": "Planificador de visitas a obras",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "lint": "@php scripts/lint.php",
        "test:unit": "@php vendor/bin/phpunit --testsuite unit",
        "test:integration": "@php vendor/bin/phpunit --testsuite integration",
        "test:api": "@php vendor/bin/phpunit --testsuite api",
        "test": [
            "@test:unit",
            "@test:integration",
            "@test:api"
        ],
        "check:security": "bash scripts/check-security.sh",
        "verify": [
            "@lint",
            "@test",
            "@check:security"
        ]
    }
}
