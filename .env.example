# Copia este archivo como .env (Copy-Item .env.example .env) y pon tus valores.
# .env no se sube nunca a git. Aquí solo hay valores de ejemplo, no reales.

# development | production. Solo decide el detalle de los logs internos.
APP_ENV=development

# Conexión de la aplicación (usuario app_planificador, se crea en la Fase 1).
DATABASE_URL=postgres://app_planificador:cambia_esto@localhost:5432/planificador

# Conexión de los tests de integración y api. Nunca apunta a la base de desarrollo.
DATABASE_URL_TEST=postgres://app_planificador:cambia_esto@localhost:5432/planificador_test

# Contraseña de los usuarios demo (bin/crear_usuarios_demo.php, Fase 1).
DEMO_PASSWORD=cambia_esto

# Carpeta bin de PostgreSQL 16 (psql, pg_isready).
PG_BIN=C:\Program Files\PostgreSQL\16\bin
