# Copia este archivo como .env (Copy-Item .env.example .env) y pon tus valores.
# .env no se sube nunca a git. Aquí solo hay valores de ejemplo, no reales.
# Si una contraseña tiene caracteres especiales (@ : / # ?), codifícalos en la URL (%40, %3A...).

# development | production. Solo decide el detalle de los logs internos.
APP_ENV=development

# Conexión de la aplicación: usuario app_planificador (solo SELECT, INSERT, UPDATE).
DATABASE_URL=postgres://app_planificador:cambia_esto@localhost:5432/planificador

# Conexión del usuario propietario, para migraciones y seed. Distinto del de la aplicación.
DATABASE_ADMIN_URL=postgres://planificador_admin:cambia_esto_tambien@localhost:5432/planificador

# Las mismas conexiones contra la base de tests. Mismo usuario y contraseña que las anteriores.
# La base debe acabar en _test: los tests se niegan a usar cualquier otra.
DATABASE_URL_TEST=postgres://app_planificador:cambia_esto@localhost:5432/planificador_test
DATABASE_ADMIN_URL_TEST=postgres://planificador_admin:cambia_esto_tambien@localhost:5432/planificador_test

# Contraseña de los usuarios demo (bin/crear_usuarios_demo.php).
DEMO_PASSWORD=cambia_esto

# Carpeta bin de PostgreSQL 16 (psql, pg_isready).
PG_BIN=C:\Program Files\PostgreSQL\16\bin
